})  

-- Combat Tab  
CombatTab:CreateToggle({  
   Name = "Kill Aura",  
   CurrentValue = false,  
   Flag = "KillAura",  
   Callback = function(Value)  
      -- Logic kill aura  
   end,  
})  

-- Teleport Tab  
TeleportTab:CreateButton({  
   Name = "Teleport to Second Sea",  
   Callback = function()  
      -- Logic teleport  
      TweenTo(Vector3.new(-197.5, 331.8, -11238.5))  -- Ví dụ vị trí  
   end,  
})  

-- Misc Tab  
MiscTab:CreateSlider({  
   Name = "Fly Speed",  
   Range = {50, 500},  
   Increment = 10,  
   Suffix = "Speed",  
   CurrentValue = 100,  
   Flag = "FlySpeed",  
   Callback = function(Value)  
      FlySpeed = Value  
   end,  
})  

MiscTab:CreateToggle({  
   Name = "Fly",  
   CurrentValue = false,  
   Flag = "Fly",  
   Callback = function(Value)  
      if Value then  
         -- Logic fly  
         local bodyVelocity = Instance.new("BodyVelocity", HumanoidRootPart)  
         bodyVelocity.Velocity = Vector3.new(0, FlySpeed, 0)  
         -- Cập nhật theo input  
      end  
   end,  
})  

MiscTab:CreateToggle({  
   Name = "NoClip",  
   CurrentValue = false,  
   Flag = "NoClip",  
   Callback = function(Value)  
      NoClip = Value  
      if Value then  
         RunService.Stepped:Connect(function()  
            for _, part in pairs(Character:GetChildren()) do  
               if part:IsA("BasePart") then  
                  part.CanCollide = false  
               end  
            end  
         end)  
      end  
   end,  
})  

MiscTab:CreateButton({  
   Name = "Server Hop",  
   Callback = function()  
      local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))  
      local serverId = servers.data[math.random(1, #servers.data)].id  
      game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, serverId)  
   end,  
})  

-- Auto reconnect khi disconnect  
LocalPlayer.CharacterAdded:Connect(function(char)  
   Character = char  
   HumanoidRootPart = char:WaitForChild("HumanoidRootPart")  
   Humanoid = char:WaitForChild("Humanoid")  
end)