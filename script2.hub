local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()  

local Window = Rayfield:CreateWindow({  
   Name = "Afua Hub",  
   LoadingTitle = "Loading Afua Hub...",  
   LoadingSubtitle = "by Afua",  
   ConfigurationSaving = {  
      Enabled = true,  
      FolderName = "AfuaHub",  
      FileName = "Config"  
   },  
   KeySystem = false,  
   Image = "rbxassetid://6403493627"  
})  

local FarmTab = Window:CreateTab("Farm", 4483362458)  
local CombatTab = Window:CreateTab("Combat", 4483362458)  
local TeleportTab = Window:CreateTab("Teleport", 4483362458)  
local MiscTab = Window:CreateTab("Misc", 4483362458)  

-- Services  
local Players = game:GetService("Players")  
local RunService = game:GetService("RunService")  
local TweenService = game:GetService("TweenService")  
local ReplicatedStorage = game:GetService("ReplicatedStorage")  
local VirtualUser = game:GetService("VirtualUser")  
local VirtualInputManager = game:GetService("VirtualInputManager")  
local HttpService = game:GetService("HttpService")  
local LocalPlayer = Players.LocalPlayer  
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()  
local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart")  
local Humanoid = Character:WaitForChild("Humanoid")  

-- Biến toàn cục  
local AutoFarmLevel = false  
local AutoMastery = false  
local AutoBoss = false  
local FruitSniper = false  
local FlySpeed = 100  
local NoClip = false  
local SelectedWeapon = "Melee"  
local AutoV4 = false  
local HealthThreshold = 5000  -- Lượng máu để chuyển weapon khi farm mastery  
local GunFarmAutoShoot = false  
local SkillDelay = 0.5  -- Delay không spam skill chưa unlock  

-- Function chung  
local function GetWeapon(toolType)  
    local backpack = LocalPlayer.Backpack  
    for _, tool in pairs(backpack:GetChildren()) do  
        if tool:IsA("Tool") and tool.ToolTip == toolType then  
            return tool  
        end  
    end  
    return nil  
end  

local function EquipWeapon(toolType)  
    local tool = GetWeapon(toolType)  
    if tool then  
        Humanoid:EquipTool(tool)  
    end  
end  

local function TweenTo(position)  
    local distance = (HumanoidRootPart.Position - position).Magnitude  
    local tweenInfo = TweenInfo.new(distance / 300, Enum.EasingStyle.Linear)  
    local tween = TweenService:Create(HumanoidRootPart, tweenInfo, {CFrame = CFrame.new(position)})  
    tween:Play()  
    tween.Completed:Wait()  
end  

local function GetNearestMob(seaOnly)  
    local nearest, dist = nil, math.huge  
    for _, mob in pairs(workspace.Enemies:GetChildren()) do  
        if mob:IsA("Model") and mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then  
            if not seaOnly or string.find(mob.Name:lower(), "sea") then  -- Ưu tiên sea beast nếu seaOnly  
                local mobDist = (HumanoidRootPart.Position - mob.HumanoidRootPart.Position).Magnitude  
                if mobDist < dist then  
                    nearest = mob  
                    dist = mobDist  
                end  
            end  
        end  
    end  
    return nearest  
end  

local function AttackMob(mob)  
    EquipWeapon(SelectedWeapon)  
    TweenTo(mob.HumanoidRootPart.Position + Vector3.new(0, 5, 0))  
    VirtualUser:ClickButton1(Vector2.new())  
end  

local function CheckRageAndActivateV4()  
    -- Giả sử rage là attribute hoặc value trong character, chỉnh theo game (ví dụ: LocalPlayer.PlayerGui.Main.Rage.Value)  
    local rage = LocalPlayer.PlayerGui.Main.Rage.Value  -- Thay bằng path thực tế đến rage  
    if rage >= 100 and AutoV4 then  -- Giả sử full rage là 100  
        VirtualInputManager:SendKeyEvent(true, "Y", false, game)  -- Bấm Y  
        task.wait(0.1)  
        VirtualInputManager:SendKeyEvent(false, "Y", false, game)  
    end  
end  

local function FarmMasteryLogic()  
    if Humanoid.Health <= HealthThreshold then return end  -- Không farm nếu health thấp  
    local tool = Character:FindFirstChildOfClass("Tool")  
    if tool and tool:FindFirstChild("Mastery") then  
        local mastery = tool.Mastery.Value  -- Giả sử mastery value  
        if mastery >= 300 then  -- Threshold để mở skill, ví dụ  
            -- Chuyển qua fruit hoặc gun  
            local nextType = (SelectedWeapon == "Fruit") and "Gun" or "Fruit"  
            EquipWeapon(nextType)  
            SelectedWeapon = nextType  
        else  
            -- Dùng skill chưa unlock nhưng không spam  
            if tool:FindFirstChild("SkillRemote") then  -- Giả sử remote cho skill  
                tool.SkillRemote:FireServer()  
                task.wait(SkillDelay)  
            end  
        end  
    end  
end  

local function GunFarmLogic()  
    local tool = GetWeapon("Gun")  
    if tool and tool.Mastery.Value < 300 then  -- Chưa đủ mở skill  
        EquipWeapon("Gun")  
        VirtualUser:ClickButton1(Vector2.new())  -- Tự bắn normal  
        task.wait(0.2)  -- Không spam quá nhanh  
    end  
end  

-- Farm Tab  
FarmTab:CreateToggle({  
   Name = "Auto Farm Level (Third Sea Sea Farm)",  
   CurrentValue = false,  
   Flag = "AutoFarmLevel",  
   Callback = function(Value)  
      AutoFarmLevel = Value  
      if Value then  
         -- Teleport đến NPC Boat Dealer ở Third Sea để xuống biển  
         TweenTo(Vector3.new(-197.5, 331.8, -11238.5))  -- Ví dụ vị trí Boat Dealer Third Sea  
         ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyBoat")  -- Mua thuyền nếu cần  
         while AutoFarmLevel do  
            task.wait()  
            local mob = GetNearestMob(true)  -- Ưu tiên sea mobs  
            if mob then  
               AttackMob(mob)  
            end  
         end  
      end  
   end,  
})  

FarmTab:CreateToggle({  
   Name = "Auto Mastery Farm (Chuyển Weapon Khi Đủ Health)",  
   CurrentValue = false,  
   Flag = "AutoMastery",  
   Callback = function(Value)  
      AutoMastery = Value  
      if Value then  
         while AutoMastery do  
            task.wait()  
            FarmMasteryLogic()  
            local mob = GetNearestMob()  
            if mob then  
               AttackMob(mob)  
            end  
         end  
      end  
   end,  
})  

FarmTab:CreateToggle({  
   Name = "Auto Boss Farm",  
   CurrentValue = false,  
   Flag = "AutoBoss",  
   Callback = function(Value)  
      AutoBoss = Value  
      -- Logic farm boss tối ưu  
   end,  
})  

FarmTab:CreateToggle({  
   Name = "Fruit Sniper",  
   CurrentValue = false,  
   Flag = "FruitSniper",  
   Callback = function(Value)  
      FruitSniper = Value  
      -- Logic ESP và grab fruit  
   end,  
})  

FarmTab:CreateToggle({  
   Name = "Auto V4 (Full Rage Mới Bấm Y)",  
   CurrentValue = false,  
   Flag = "AutoV4",  
   Callback = function(Value)  
      AutoV4 = Value  
      if Value then  
         while AutoV4 do  
            task.wait(1)  -- Check mỗi giây  
            CheckRageAndActivateV4()  
         end  
      end  
   end,  
})  

FarmTab:CreateToggle({  
   Name = "Gun Farm (Tự Bắn Khi Chưa Mở Skill)",  
   CurrentValue = false,  
   Flag = "GunFarmAutoShoot",  
   Callback = function(Value)  
      GunFarmAutoShoot = Value  
      if Value then  
         while GunFarmAutoShoot do  
            task.wait()  
            GunFarmLogic()  
            local mob = GetNearestMob()  
            if mob then  
               AttackMob(mob)  
            end  
         end  
      end  
   end,  
})  

FarmTab:CreateSlider({  
   Name = "Health Threshold Mastery",  
   Range = {1000, 10000},  
   Increment = 500,  
   Suffix = "HP",  
   CurrentValue = 5000,  
   Flag = "HealthThreshold",  
   Callback = function(Value)  
      HealthThreshold = Value  
   end,  
})  

FarmTab:CreateDropdown({  
   Name = "Select Weapon",  
   Options = {"Melee", "Sword", "Gun", "Fruit"},  
   CurrentOption = "Melee",  
   Flag = "SelectedWeapon",  
   Callback = function(Option)  
      SelectedWeapon = Option  
   end,  
})  

-- Combat Tab  
CombatTab:CreateToggle({  
   Name = "Kill Aura",  
   CurrentValue = false,  
   Flag = "KillAura",  
   Callback = function(Value)  
      -- Logic kill aura tối ưu  
   end,  
})  

-- Teleport Tab  
TeleportTab:CreateButton({  
   Name = "Teleport to Third Sea",  
   Callback = function()  
      TweenTo(Vector3.new(-197.5, 331.8, -11238.5))  
   end,  
})  

-- Misc Tab (giữ nguyên như cũ, thêm nếu cần)  
MiscTab:CreateSlider({  
   Name = "Fly Speed",  
   Range = {50, 500},  
   Increment = 10,  
   Suffix = "Speed",  
   CurrentValue = 100,  
   Flag = "FlySpeed",  
   Callback = function(Value)  
      FlySpeed = Value  
   end,  
})  

MiscTab:CreateToggle({  
   Name = "Fly",  
   CurrentValue = false,  
   Flag = "Fly",  
   Callback = function(Value)  
      if Value then  
         local bodyVelocity = Instance.new("BodyVelocity", HumanoidRootPart)  
         bodyVelocity.Velocity = Vector3.new(0, FlySpeed, 0)  
         -- Cập nhật theo input (thêm logic di chuyển)  
      end  
   end,  
})  

MiscTab:CreateToggle({  
   Name = "NoClip",  
   CurrentValue = false,  
   Flag = "NoClip",  
   Callback = function(Value)  
      NoClip = Value  
      if Value then  
         RunService.Stepped:Connect(function()  
            for _, part in pairs(Character:GetChildren()) do  
               if part:IsA("BasePart") then  
                  part.CanCollide = false  
               end  
            end  
         end)  
      end  
   end,  
})  

MiscTab:CreateButton({  
   Name = "Server Hop",  
   Callback = function()  
      local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))  
      local serverId = servers.data[math.random(1, #servers.data)].id  
      game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, serverId)  
   end,  
})  

-- Auto reconnect  
LocalPlayer.CharacterAdded:Connect(function(char)  
   Character = char  
   HumanoidRootPart = char:WaitForChild("HumanoidRootPart")  
   Humanoid = char:WaitForChild("Humanoid")  
end)